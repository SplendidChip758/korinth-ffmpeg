[Unit]
Description=Korinth Industries ffmpeg service
Documentation=https://n8n.donahay.net
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/korinth-ffmpeg.env
WorkingDirectory=/opt/korinth-ffmpeg
ExecStart=/opt/korinth-ffmpeg/venv/bin/uvicorn app:app \
    --host 0.0.0.0 --port 8080 --timeout-keep-alive 120
Restart=always
RestartSec=5
User=korinth
Group=korinth

# ffmpeg is CPU-hungry; keep it from starving the rest of the container.
Nice=5

# Hardening. The service only ever needs to write to its own data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/korinth-ffmpeg

[Install]
WantedBy=multi-user.target
