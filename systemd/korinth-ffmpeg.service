[Unit]
Description=Korinth Industries ffmpeg service
Documentation=https://n8n.donahay.net
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/korinth-ffmpeg.env
WorkingDirectory=/opt/korinth-ffmpeg
ExecStart=/opt/korinth-ffmpeg/venv/bin/uvicorn app:app \
    --host 0.0.0.0 --port 8080 --timeout-keep-alive 120
Restart=always
RestartSec=5
User=korinth
Group=korinth

# ffmpeg is CPU-hungry; keep it from starving the rest of the container.
Nice=5

# Hardening. ProtectSystem=strict makes the whole filesystem read-only except
# the paths named below - a missing entry here shows up as EROFS at the write
# site, not at startup. The service only ever needs its own data dir plus,
# if ARCHIVE_DIR is set, the share it copies finished episodes onto.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/korinth-ffmpeg /mnt/korinth-out

[Install]
WantedBy=multi-user.target
