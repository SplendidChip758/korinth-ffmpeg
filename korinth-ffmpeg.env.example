# Copied to /etc/korinth-ffmpeg.env on first install. install.sh generates
# X_AUTH_TOKEN automatically and never touches this file again on later runs —
# edit values here only for a *fresh* install, or edit /etc/korinth-ffmpeg.env
# directly on the live box.

X_AUTH_TOKEN=changeme

# Where job directories live. Must match ReadWritePaths= in the systemd unit.
DATA_DIR=/var/lib/korinth-ffmpeg

# Job directories older than this are swept on the next /concat or /assemble
MAX_JOB_AGE_SECONDS=21600

# --- long-form TTS -----------------------------------------------------------
# Required by POST /narrate — the service calls Gemini directly so it can probe
# the resulting wav and return a MEASURED duration instead of an estimate.
GEMINI_API_KEY=
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Orus

# --- assembly tuning ---------------------------------------------------------
# Duck level for Veo ambience under narration (0.0–1.0)
AMBIENT_VOLUME=0.3

# Long-form assembly padding, seconds
PAD=0.4

# Output frame rate for the long-form path (/assemble)
OUT_FPS=25

# KORINTH_VERSION and KORINTH_GIT_SHA are appended automatically by
# install.sh on every deploy — do not set them here.
