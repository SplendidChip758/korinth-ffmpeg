# Copied to /etc/korinth-ffmpeg.env on first install. install.sh generates
# X_AUTH_TOKEN automatically and never touches this file again on later runs —
# edit values here only for a *fresh* install, or edit /etc/korinth-ffmpeg.env
# directly on the live box.

X_AUTH_TOKEN=changeme

# Where job directories live. Must match ReadWritePaths= in the systemd unit.
DATA_DIR=/var/lib/korinth-ffmpeg

# Job directories older than this are swept on the next /concat or /assemble
MAX_JOB_AGE_SECONDS=21600

# Where /assemble copies the finished mp4 before deleting the job folder.
# Must match ReadWritePaths= in the systemd unit, and be a real mount - a
# missing/unwritable share shows up as EROFS on the first /assemble, not at
# startup. Leave unset to keep the old behaviour (stream bytes back, nothing
# is kept on disk after the response).
ARCHIVE_DIR=/mnt/korinth-industries/korinth-out

# --- long-form TTS -----------------------------------------------------------
# Required by POST /narrate — the service calls Gemini TTS on Cloud
# Text-to-Speech directly so it can probe the resulting wav and return a
# MEASURED duration instead of an estimate. GEAP's GCP project issues service
# account keys, not AI Studio GEMINI_API_KEY values, so auth here is a service
# account, not an API key.
#
# 1. Enable the API on the project:
#      gcloud services enable texttospeech.googleapis.com --project <project>
# 2. Create a service account and grant it, on that project:
#      roles/serviceusage.serviceUsageConsumer   (makes x-goog-user-project
#                                                 legal — without it you get a
#                                                 403 about the *caller* that
#                                                 reads like a TTS permission
#                                                 error and is not one)
# 3. Download its JSON key and place it on this box at
#    /etc/korinth-ffmpeg/service-account.json, then:
#      chown root:korinth /etc/korinth-ffmpeg/service-account.json
#      chmod 0640 /etc/korinth-ffmpeg/service-account.json
# That's it — the project id is read out of the key file's own "project_id"
# field, no separate config needed. GCP_PROJECT_ID only exists to override
# which project quota and billing are pinned to, for the unusual case where
# that differs from the one that issued the key. Leave it blank.
# (GCP_PROJECT is accepted as an alias for GCP_PROJECT_ID.)
GOOGLE_APPLICATION_CREDENTIALS=/etc/korinth-ffmpeg/service-account.json
GCP_PROJECT_ID=
# text:synthesize is a global endpoint, so this no longer selects a region for
# narration. Only /health still reports it.
GCP_LOCATION=us-central1
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Orus
TTS_LANGUAGE=en-US
# The style instruction. Sent as input.prompt — its own field, separate from
# the narration text, so it is never read aloud. No trailing colon needed.
# TTS_STYLE=

# --- assembly tuning ---------------------------------------------------------
# Duck level for Veo ambience under narration (0.0–1.0)
AMBIENT_VOLUME=0.3

# Long-form assembly padding, seconds
PAD=0.4

# Output frame rate for the long-form path (/assemble)
OUT_FPS=25

# KORINTH_VERSION and KORINTH_GIT_SHA are appended automatically by
# install.sh on every deploy — do not set them here.
