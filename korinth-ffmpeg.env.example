# Copied to /etc/korinth-ffmpeg.env on first install. install.sh generates
# X_AUTH_TOKEN automatically and never touches this file again on later runs —
# edit values here only for a *fresh* install, or edit /etc/korinth-ffmpeg.env
# directly on the live box.

X_AUTH_TOKEN=changeme

# Where job directories live. Must match ReadWritePaths= in the systemd unit.
DATA_DIR=/var/lib/korinth-ffmpeg

# DEBUG / INFO / WARNING / ERROR / CRITICAL. Everything goes to the journal:
#   journalctl -u korinth-ffmpeg -f
#
# INFO is one or two lines per pipeline step — enough to follow a render and see
# where it stopped. DEBUG adds every ffmpeg argv, every ffprobe result and the
# resolved style prompt. Turn it on for one reproduction run and turn it back
# off: a fourteen-segment episode is a few hundred lines at DEBUG, and the argv
# lines are long. A value that isn't one of the five falls back to INFO and says
# so in the startup banner rather than silently logging nothing.
LOG_LEVEL=INFO

# Job directories older than this are swept on the next /concat or /assemble
MAX_JOB_AGE_SECONDS=21600

# Where /assemble copies the finished mp4 before deleting the job folder.
# Must match ReadWritePaths= in the systemd unit, and be a real mount - a
# missing/unwritable share shows up as EROFS on the first /assemble, not at
# startup. Leave unset to keep the old behaviour (stream bytes back, nothing
# is kept on disk after the response).
ARCHIVE_DIR=/mnt/korinth-industries/korinth-out

# --- long-form TTS -----------------------------------------------------------
# Required by POST /narrate — the service calls Gemini TTS on Cloud
# Text-to-Speech directly so it can probe the resulting wav and return a
# MEASURED duration instead of an estimate. GEAP's GCP project issues service
# account keys, not AI Studio GEMINI_API_KEY values, so auth here is a service
# account, not an API key.
#
# 1. Enable the API on the project:
#      gcloud services enable texttospeech.googleapis.com --project <project>
# 2. Create a service account and grant it, on that project:
#      roles/serviceusage.serviceUsageConsumer   (makes x-goog-user-project
#                                                 legal — without it you get a
#                                                 403 about the *caller* that
#                                                 reads like a TTS permission
#                                                 error and is not one)
# 3. Download its JSON key and place it on this box at
#    /etc/korinth-ffmpeg/service-account.json, then:
#      chown root:korinth /etc/korinth-ffmpeg/service-account.json
#      chmod 0640 /etc/korinth-ffmpeg/service-account.json
# That's it — the project id is read out of the key file's own "project_id"
# field, no separate config needed. GCP_PROJECT_ID only exists to override
# which project quota and billing are pinned to, for the unusual case where
# that differs from the one that issued the key. Leave it blank.
# (GCP_PROJECT is accepted as an alias for GCP_PROJECT_ID.)
GOOGLE_APPLICATION_CREDENTIALS=/etc/korinth-ffmpeg/service-account.json
GCP_PROJECT_ID=
# text:synthesize is a global endpoint, so this no longer selects a region for
# narration. Only /health still reports it.
GCP_LOCATION=us-central1
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_LANGUAGE=en-US

# Voice and style come from a named preset table on the share, not from these
# env vars. Each preset carries both fields together, so the pair cannot be
# half-changed into a read that does one job and not the other — and the
# rejected auditions keep their reasons, which is the part that otherwise gets
# lost. The channel currently uses ONE narrator for every episode: the
# `narrator` preset, Umbriel plus the locked style prompt.
#
# The table is hand-written and read directly off the share; the service never
# writes it, and a canon-build step populating compiled/ must copy it through
# rather than overwrite it. It is re-read whenever its mtime changes, so
# editing a voice needs no restart, and a file that is mid-edit or briefly
# malformed keeps serving the last good copy — a typo in a prompt must not take
# narration down in the middle of a fourteen-segment render.
#
# Seed it by copying tts-presets.json from the repo to the path below.
TTS_PRESETS_FILE=/mnt/korinth-industries/compiled/tts-presets.json

# The fallback layer, in order, when the table cannot answer:
#
#   1. explicit voice / style in the request body (korinth-audition.sh)
#   2. the named preset from the table above
#   3. TTS_VOICE / TTS_STYLE below — the pre-4.6.0 behaviour
#   4. the locked read hardcoded in korinth_tts_presets.py
#
# An unknown preset name does NOT fail the request. It falls back to the
# table's default_preset and the response sets preset_substituted: true, so the
# substitution is visible in the n8n execution. Failing segment nine of
# fourteen over a typo in a slug is a worse outcome than a consistent wrong
# narrator.
#
# Leave 3 set and matching the locked preset. It is what answers if the share
# is unmounted, which is the difference between narration that sounds unchanged
# and narration that sounds wrong. /health reports the table under
# tts_presets — `loaded: false` with an `error` means layer 3 is in use.
TTS_VOICE=Umbriel
TTS_STYLE=Read this as someone recounting a case they worked. Deliberate and grounded, quietly gripping, the pacing of a story being told rather than a report being read. Serious throughout, never theatrical.

# --- assembly tuning ---------------------------------------------------------
# Duck level for Veo ambience under narration (0.0–1.0)
AMBIENT_VOLUME=0.3

# Long-form assembly padding, seconds
PAD=0.4

# Output frame rate for the long-form path (/assemble)
OUT_FPS=25

# KORINTH_VERSION and KORINTH_GIT_SHA are appended automatically by
# install.sh on every deploy — do not set them here.
